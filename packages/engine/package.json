{
  "name": "spillpoint",
  "version": "0.2.0",
  "description": "Exit waterfall engine: who gets what at every exit value, with every breakpoint explained.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "cap table",
    "waterfall",
    "liquidation preference",
    "exit",
    "breakpoints",
    "startup",
    "venture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spillpoint/spillpoint.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/spillpoint/spillpoint#readme",
  "bugs": "https://github.com/spillpoint/spillpoint/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-declarations.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
