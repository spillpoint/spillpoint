{
  "name": "spillpoint-workspace",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @spillpoint/dashboard dev",
    "preview": "pnpm --filter @spillpoint/dashboard build && pnpm --filter @spillpoint/dashboard preview",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:reference": "python3 -m unittest discover reference/tests && python3 reference/generate.py --check",
    "payouts": "node packages/engine/scripts/payouts.ts",
    "breakpoints": "node packages/engine/scripts/breakpoints.ts",
    "ocf-check": "pnpm --silent --filter spillpoint build && node --no-warnings=ExperimentalWarning scripts/ocf-check.mjs",
    "rounds": "node packages/engine/scripts/rounds.ts"
  }
}
